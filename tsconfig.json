{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "allowJs": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@flightpilot/shared": ["packages/shared/src/index.ts"],
      "@flightpilot/core": ["packages/core/src/index.ts"],
      "@flightpilot/providers": ["packages/providers/src/index.ts"],
      "@flightpilot/pricing-engine": ["packages/pricing-engine/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "*.ts"
  ],
  "exclude": ["node_modules", "apps/web/.next"]
}
