# pnpm dev generates secure local secrets if .env does not exist. Never commit .env.
FLIGHTPILOT_MODE=simulation
FLIGHTPILOT_BASE_URL=http://127.0.0.1:3000
FLIGHTPILOT_API_TOKEN=replace-with-at-least-32-random-characters
FLIGHTPILOT_ENCRYPTION_KEY=replace-with-64-hex-characters
# Duffel test mode only. No live token is accepted.
# DUFFEL_ACCESS_TOKEN=duffel_test_...
# DUFFEL_WEBHOOK_SECRET=
# Optional real PostgreSQL; default is local PostgreSQL-compatible PGlite at .data
# DATABASE_URL=postgresql://flightpilot:localdev@127.0.0.1:5432/flightpilot
